{
  "name": "app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@tanstack/react-query": "^5.90.12",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.27",
    "expo-asset": "^12.0.9",
    "expo-crypto": "^15.0.8",
    "expo-file-system": "^19.0.14",
    "expo-image": "~3.0.10",
    "expo-image-picker": "^17.0.8",
    "expo-linear-gradient": "~15.0.6",
    "expo-local-authentication": "^17.0.7",
    "expo-secure-store": "^15.0.7",
    "expo-sharing": "^14.0.7",
    "expo-status-bar": "~3.0.7",
    "firebase": "^12.3.0",
    "react": "19.1.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "^4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~54.0.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./__tests__/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|expo|@expo|expo-crypto|expo-secure-store|base64-js|react-native-reanimated|react-native-chart-kit)/)"
    ],
    "moduleNameMapper": {
      "^@expo/vector-icons$": "<rootDir>/__tests__/__mocks__/expo-vector-icons.js",
      "^expo-crypto$": "<rootDir>/__tests__/__mocks__/expo-crypto.js"
    },
    "collectCoverageFrom": [
      "components/**/*.{js,jsx}",
      "contexts/**/*.{js,jsx}",
      "!**/node_modules/**",
      "!**/*.test.{js,jsx}",
      "!**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "coverage",
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    }
  },
  "private": true
}
